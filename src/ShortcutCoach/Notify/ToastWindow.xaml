<Window x:Class="ShortcutCoach.Notify.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShortcutCoach toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Border Background="#E6202020" CornerRadius="6" Padding="10,6">
        <TextBlock x:Name="MessageText" Foreground="White" FontFamily="Segoe UI" FontSize="14" />
    </Border>
</Window>
